# gp-tv settings. install.sh reads them from /etc/gp-tv/tv.env, which is root
# only (mode 600) and never part of the repo. Single-quote every value.
# The first install writes that file from this one, filled in from whatever the
# Pi is already running, so on a box that works today there is nothing to edit.

# GabeFi, the access point the TV serves on wlan0 (hostapd, 5 GHz, 10.42.0.1).
GABEFI_SSID='GabeFi'
# 8 to 63 characters. Left empty, install.sh does not touch hostapd.conf.
GABEFI_PSK=''
WIFI_COUNTRY='GB'
# MACs that may never join GabeFi, space separated. The phone that provides the
# uplink belongs here, or it joins the network it feeds and loops.
GABEFI_DENY_MACS=''

# Standby uplink on wlan1, a phone hotspot. The watchdog dials it when it is in
# range and nothing else is. Empty UPLINK_SSID means no standby. Empty
# UPLINK_PSK keeps an existing gabepi-uplink connection as it is.
UPLINK_SSID=''
UPLINK_PSK=''

# Home screen. GABETV_CAL_URL answers ?date_from=YYYY-MM-DD&date_to=YYYY-MM-DD
# with a JSON list of calendar entries. Empty values hide that panel.
GABETV_CAL_URL=''
GABETV_LAT=''
GABETV_LON=''
GABETV_TZ='Europe/London'
