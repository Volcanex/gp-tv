# --------------------------------------------------------------------- pad ---
class PadHub(threading.Thread):
    """Reads every /dev/input/js*, so either controller drives the menu."""
    daemon = True

    def __init__(self):
        super().__init__()
        self.q = []
        self.seen = {}

    def _reader(self, path):
        try:
            with open(path, "rb") as f:
                while True:
                    ev = f.read(8)
                    if len(ev) < 8:
                        break
                    _, val, typ, num = struct.unpack("IhBB", ev)
                    if typ & 0x80:
                        continue
                    if typ & 0x02:
                        if num in (1, 5, 7):
                            if val < -16000: self.q.append("up")
                            elif val > 16000: self.q.append("down")
                    elif typ & 0x01 and val == 1:
                        if num in (4, 13):   self.q.append("up")
                        elif num in (6, 14): self.q.append("down")
                        else:                self.q.append("select")
        except Exception:
            pass
        finally:
            self.seen.pop(path, None)

    def run(self):
        while True:
            try:
                for n in sorted(os.listdir("/dev/input")):
                    if not n.startswith("js"):
                        continue
                    p = "/dev/input/" + n
                    if p not in self.seen:
                        th = threading.Thread(target=self._reader, args=(p,), daemon=True)
                        self.seen[p] = th
                        th.start()
            except Exception:
                pass
            time.sleep(3)

    @property
    def count(self):
        return len(self.seen)

    def get(self):
        return self.q.pop(0) if self.q else None

    def drain(self):
        """Throw away anything queued while we were not looking.

        The readers keep consuming js* for the whole time a game is on screen,
        so the PS press that quits retroarch also lands here as a select.
        Without this it is acted on the instant the menu redraws, and the game
        you just quit launches straight back up."""
        self.q.clear()


