def ports():
    sub = []
    for label, prog, args, needs in PORTS:
        if not os.path.exists(prog) or (needs and not os.path.exists(needs)):
            continue
        if any(a.startswith("/") and not os.path.exists(a) for a in args):
            continue
        sub.append(("Play " + label, "/usr/local/bin/gabetv-run "
                    + " ".join(shlex.quote(x) for x in [prog] + args)))
    if not sub:
        return []
    sub.append(("Back", BACK))
    return [("PC games  (%d)" % (len(sub) - 1), sub)]


