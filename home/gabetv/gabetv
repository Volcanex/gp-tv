#!/usr/bin/env python3
"""
GabeTV: a dashboard for the day, a menu, and the Pi's diagnostics.

The home screen, shown with no keypress, is today's g-system calendar (most of
the screen), tomorrow, the local weather, a big clock and the part of the
daily routine we are in (routine.txt beside this file). Any button opens the
menu: Diagnostics, the games, and the system actions. After a spell with no
input it falls back to the home screen.

Runs on tty1, the HDMI console. Pure stdlib curses, no dependencies. Reads the
keyboard and every /dev/input/js* directly, so a PS3 pad drives it with no
key-mapping daemon in the way.

Design note. Everything expensive lives in the Sampler thread on a slow
cadence, and draw() only ever reads the snapshot it publishes. The previous
version shelled out about twenty times every five seconds, two of them
full-boot journalctl scans, which is a lot of work for a board that is already
fighting for current.

Graphs are deliberately ascii. The linux console font has no unicode block
glyphs, so the usual sparkline characters come out as blanks on a tv.

AirPlay and games override this automatically by taking DRM; the console
reappears underneath when they exit.

Undo: remove the launch line from ~/.bash_profile.
"""
import curses, datetime, json, os, re, shlex, struct, subprocess, threading, time
import urllib.parse
import urllib.request
from collections import deque

HIST   = 110         # samples kept for the fast sparklines
SHIST  = 60          # samples kept for the slow ones
FAST   = 2           # seconds between cheap samples (pure file reads)
SLOW   = 25          # seconds between expensive samples (subprocesses)
RAMP   = "_.:-=+*#"  # 8 ascii levels, low to high

CORE_DIR = "/usr/lib/aarch64-linux-gnu/libretro"
ROMS     = os.path.expanduser("~/roms")
LEASES   = "/var/lib/misc/dnsmasq.leases"

# Only systems this chip can actually hold at full speed. No n64. PlayStation
# runs on pcsx_rearmed (arm dynarec), which debian does not package, so its core
# was dropped into CORE_DIR by hand from the libretro buildbot on 2026-09-23.
# Debian's pcsxr would not keep up: it falls back to an interpreter.
SYSTEMS = [
    ("NES",              "nestopia",        (".nes", ".fds")),
    ("SNES",             "snes9x",          (".sfc", ".smc")),
    ("Mega Drive",       "genesis_plus_gx", (".md", ".gen", ".bin")),
    ("Master System",    "genesis_plus_gx", (".sms", ".gg")),
    ("Game Boy",         "gambatte",        (".gb", ".gbc")),
    ("Game Boy Advance", "mgba",            (".gba",)),
    ("Virtual Boy",      "mednafen_vb",     (".vb",)),
    ("WonderSwan",       "mednafen_wswan",  (".ws", ".wsc")),
    ("PlayStation",      "pcsx_rearmed",    (".cue", ".chd", ".pbp")),
]

BACK = object()          # sentinel: a menu entry that pops back up a level
DIAG = object()          # sentinel: the menu entry that opens diagnostics

# Set while a command launched from the menu (a game, mostly) is running. The
# Sampler sleeps instead of sampling: its vcgencmd calls go through the same
# firmware as the headphone audio and were measured stalling retroarch.
PAUSED = threading.Event()


def sh(cmd, default="?", timeout=6):
    try:
        out = subprocess.run(cmd, shell=True, capture_output=True, text=True,
                             timeout=timeout).stdout.strip()
        return out or default
    except Exception:
        return default


def read(path, default=""):
    try:
        with open(path) as fh:
            return fh.read()
    except OSError:
        return default


# ---------------------------------------------------------------- sampler ---
class Sampler(threading.Thread):
    """Collects everything the board shows, so drawing costs nothing."""
    daemon = True

    def __init__(self):
        super().__init__()
        self.lock = threading.Lock()
        self.cpu  = deque(maxlen=HIST)
        self.temp = deque(maxlen=HIST)
        self.net  = deque(maxlen=HIST)
        self.uv   = deque(maxlen=SHIST)    # undervolted at this sample, 0 or 1
        self.mem  = deque(maxlen=HIST)     # percent of ram in use
        self.wan  = deque(maxlen=SHIST)    # internet round trip, ms
        self.events = []
        self.slow = {}
        self._cpu_prev = None
        self._net_prev = None
        self._t_prev = None
        self.ready = False

    # ---- cheap tier: file reads only, no processes ----
    def _cpu_pct(self):
        parts = read("/proc/stat").split("\n")[0].split()[1:]
        if not parts:
            return 0.0
        vals = [int(x) for x in parts]
        idle, total = vals[3] + vals[4], sum(vals)
        if self._cpu_prev is None:
            self._cpu_prev = (idle, total)
            return 0.0
        di = idle - self._cpu_prev[0]
        dt = total - self._cpu_prev[1]
        self._cpu_prev = (idle, total)
        return max(0.0, min(100.0, 100.0 * (1 - di / dt))) if dt > 0 else 0.0

    def _net_bps(self):
        rx = tx = 0
        for line in read("/proc/net/dev").split("\n")[2:]:
            if ":" not in line:
                continue
            name, rest = line.split(":", 1)
            if name.strip() != "wlan0":
                continue
            f = rest.split()
            rx, tx = int(f[0]), int(f[8])
        now = time.time()
        if self._net_prev is None:
            self._net_prev, self._t_prev = (rx, tx), now
            return 0.0
        dt = max(0.001, now - self._t_prev)
        bps = ((rx - self._net_prev[0]) + (tx - self._net_prev[1])) / dt
        self._net_prev, self._t_prev = (rx, tx), now
        return max(0.0, bps)

    def _mem_pct(self):
        info = {}
        for line in read("/proc/meminfo").split("\n"):
            k, _, v = line.partition(":")
            if v:
                info[k] = float(v.split()[0])
        total = info.get("MemTotal", 1)
        avail = info.get("MemAvailable", total)
        return max(0.0, min(100.0, 100.0 * (total - avail) / total))

    def fast(self):
        c = self._cpu_pct()
        t = int(read("/sys/class/thermal/thermal_zone0/temp", "0") or 0) / 1000.0
        n = self._net_bps()
        m = self._mem_pct()
        with self.lock:
            self.cpu.append(c)
            self.temp.append(t)
            self.net.append(n)
            self.mem.append(m)

    # ---- expensive tier ----
    def stations(self):
        """Live GabeFi clients, with the numbers the driver will give us.

        This radio does not report per station signal in AP mode, so rate and
        idle time are what we have. Names come from the dhcp leases, keyed by
        mac, because the station dump only knows hardware addresses."""
        names, ips = {}, {}
        for line in read(LEASES).split("\n"):
            p = line.split()
            if len(p) > 3:
                names[p[1].lower()] = p[3]
                ips[p[1].lower()] = p[2]

        dump = sh("/usr/sbin/iw dev wlan0 station dump 2>/dev/null", "", timeout=8)
        out, cur = [], None
        for line in dump.split("\n"):
            line = line.strip()
            m = re.match(r"^Station ([0-9a-f:]{17})", line, re.I)
            if m:
                mac = m.group(1).lower()
                cur = {"mac": mac, "name": names.get(mac, mac[-8:]),
                       "ip": ips.get(mac, "?"), "tx": "?", "rx": "?",
                       "idle": "?", "ping": "-"}
                out.append(cur)
            elif cur is not None and ":" in line:
                k, _, v = line.partition(":")
                k, v = k.strip(), v.strip()
                if k == "tx bitrate":   cur["tx"] = v.split()[0].split(".")[0]
                elif k == "rx bitrate": cur["rx"] = v.split()[0].split(".")[0]
                elif k == "inactive time":
                    try: cur["idle"] = "%ds" % (int(v.split()[0]) // 1000)
                    except ValueError: pass

        return out

    def pads(self):
        out = []
        base = "/sys/class/power_supply"
        try:
            found = sorted(d for d in os.listdir(base) if d.startswith("sony_controller"))
        except OSError:
            found = []
        for i, d in enumerate(found):
            out.append({"name": "PS3 pad %d" % (i + 1),
                        "pct": read(os.path.join(base, d, "capacity"), "?").strip(),
                        "status": read(os.path.join(base, d, "status"), "?").strip()})
        return out

    def kernel_events(self):
        """One journal scan, not three. The old code ran a full boot scan twice
        every refresh just to get a count and a timestamp, which is real work on
        a board that is short of current."""
        raw = sh("journalctl -k -b --no-pager -o short 2>/dev/null | "
                 "grep -iE 'Undervoltage detected|now disconnected|Link is Down|"
                 "link becomes ready|hdmi|oom|segfault'", "", timeout=20)
        lines = [l for l in raw.split("\n") if l.strip()]
        uv = [l for l in lines if "ndervoltage" in l]
        last = " ".join(uv[-1].split()[:3]) if uv else ""
        pretty = []
        for l in lines[-7:]:
            p = l.split()
            when = " ".join(p[:3]) if len(p) > 3 else ""
            what = l.split(": ", 1)[-1] if ": " in l else l
            pretty.append((when, what[:74]))
        return len(uv), last, pretty

    def slow_refresh(self):
        uv_count, uv_last, events = self.kernel_events()
        t = sh("vcgencmd get_throttled | cut -d= -f2", "0x0")
        try: tv = int(t, 16)
        except ValueError: tv = 0

        up = sh("ip route show default | head -1 | awk '{for(i=1;i<=NF;i++) if($i==\"dev\") print $(i+1)}'", "none")
        d = {
            "throttled_raw": t,
            "uv_now":  tv & 1,
            "thr_now": (tv >> 2) & 1,
            "uv_ever": (tv >> 16) & 1,
            "uv_count": str(uv_count),
            "uv_last":  uv_last,
            "uplink": {"eth1": "iPhone over USB", "wlan1": "iPhone hotspot",
                       "eth0": "Ethernet"}.get(up, up),
            "fallback": "Armed" if sh("ip route show default | grep -c wlan1", "0") != "0" else "Asleep",
            "wan_ms": sh("ping -c1 -W2 1.1.1.1 2>/dev/null | tail -1 | cut -d/ -f5 | cut -d. -f1", "?"),
            "airplay": "Streaming" if sh("ss -tnp 2>/dev/null | grep -c uxplay", "0") != "0" else "Idle, ready",
            "chan": sh("/usr/sbin/iw dev wlan0 info 2>/dev/null | awk '/channel/{print $2}'", "?"),
            "width": sh("/usr/sbin/iw dev wlan0 info 2>/dev/null | grep -o 'width: [0-9]* MHz' | cut -d' ' -f2-", "?"),
            "arm": sh("vcgencmd measure_clock arm | cut -d= -f2 | awk '{printf \"%d\", $1/1000000}'", "?"),
            "core": sh("vcgencmd measure_clock core | cut -d= -f2 | awk '{printf \"%d\", $1/1000000}'", "?"),
            "mem": sh("free -m | awk '/^Mem:/{printf \"%d of %d MB\", $3, $2}'", "?"),
            "disk": sh("df -h / | awk 'NR==2{printf \"%s of %s\", $3, $2}'", "?"),
            "load": sh("cut -d' ' -f1-3 /proc/loadavg", "?"),
            "uptime": sh("uptime -p | sed 's/^up //'", "?"),
            "stations": self.stations(),
            "pads": self.pads(),
        }
        try:
            self.wan.append(float(d["wan_ms"]))
        except (TypeError, ValueError):
            pass
        with self.lock:
            self.uv.append(1 if d["uv_now"] else 0)
            self.events = events
            self.slow = d
            self.ready = True

    def snapshot(self):
        with self.lock:
            return {"slow": dict(self.slow), "cpu": list(self.cpu),
                    "temp": list(self.temp), "net": list(self.net),
                    "uv": list(self.uv), "mem": list(self.mem),
                    "wan": list(self.wan), "events": list(self.events)}

    def run(self):
        self.slow_refresh()
        last_slow = time.time()
        while True:
            if PAUSED.is_set():
                time.sleep(FAST)
                continue
            try:
                self.fast()
                if time.time() - last_slow > SLOW:
                    self.slow_refresh()
                    last_slow = time.time()
            except Exception:
                pass                     # a stats board must never take the tv down
            time.sleep(FAST)


# ------------------------------------------------------------------ graphs ---
def spark(series, lo=None, hi=None, width=HIST):
    if not series:
        return ""
    s = list(series)[-width:]
    lo = min(s) if lo is None else lo
    hi = max(s) if hi is None else hi
    if hi - lo < 1e-9:
        hi = lo + 1
    return "".join(RAMP[min(len(RAMP) - 1,
                    max(0, int((v - lo) / (hi - lo) * (len(RAMP) - 1))))] for v in s)


def bar(pct, width=22):
    pct = max(0.0, min(100.0, pct))
    fill = int(round(pct / 100.0 * width))
    return "[" + "#" * fill + "." * (width - fill) + "]"


def human_bps(b):
    for unit, div in (("MB/s", 1e6), ("kB/s", 1e3)):
        if b >= div:
            return "%.1f %s" % (b / div, unit)
    return "%d B/s" % b


# -------------------------------------------------------------------- menu ---
def roms_for(exts, so):
    """Every rom under ~/roms with one of these extensions, newest name order.
    Drop a file in and it appears on the next rebuild. Nothing to register."""
    out = []
    for root, _dirs, files in os.walk(ROMS):
        if os.path.basename(root) == "saves":
            continue
        # A .bin sitting next to a .cue is a disc track, not a Mega Drive rom.
        has_cue = any(x.lower().endswith(".cue") for x in files)
        for f in sorted(files):
            ext = os.path.splitext(f)[1].lower()
            if ext not in exts:
                continue
            if ext == ".bin" and has_cue:
                continue
            out.append((os.path.splitext(f)[0],
                        "/usr/local/bin/gabetv-emu -L %s %s"
                        % (shlex.quote(so), shlex.quote(os.path.join(root, f)))))
    return out


def games():
    """One entry per system, each opening a list of its roms.

    A flat list of every game does not survive a real collection, and the
    system is the thing you pick first anyway."""
    out = []
    for label, core, exts in SYSTEMS:
        so = os.path.join(CORE_DIR, core + "_libretro.so")
        if not os.path.exists(so):
            continue
        found = roms_for(exts, so)
        if not found:
            continue
        sub = [("Play " + name, cmd) for name, cmd in found]
        sub.append(("Back", BACK))
        out.append(("%s roms  (%d)" % (label, len(found)), sub))
    return out


